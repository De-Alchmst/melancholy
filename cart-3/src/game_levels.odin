package main

import "w4"

Tile :: distinct u8
TILE_NIHIL   :Tile: 0
TILE_SUSE    :Tile: 1
TILE_BOX     :Tile: 2
TILE_ROCK    :Tile: 3
TILE_PLAYER  :Tile: 4
TILE_CULTIST :Tile: 5
TILE_DEAD    :Tile: 6

Game_Level :: struct {
	layout: [20][20]Tile,
	palette: w4.Palette,
}


solid_tile_pos_p :: proc "c" (pos: Point) -> bool {
	tile := LEVELS[global_state.level_index].layout[pos.y][pos.x]

	return tile == TILE_SUSE || tile == TILE_BOX || tile == TILE_ROCK
}


